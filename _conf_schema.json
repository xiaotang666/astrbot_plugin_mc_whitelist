{
  "nickname_mode": {
    "description": "昵称直连绑定",
    "hint": "注册/注销默认用群昵称当游戏名",
    "type": "bool",
    "default": true
  },
  "nickname_strict": {
    "description": "严格校验昵称",
    "hint": "需符合 MC 规则：3-16 位字母/数字/下划线",
    "type": "bool",
    "default": true
  },
  "allow_explicit_name": {
    "description": "允许手动指定游戏名",
    "hint": "如 /注册 正 名字；关闭后只能用群昵称",
    "type": "bool",
    "default": true
  },
  "default_bind_type": {
    "description": "默认绑定类型",
    "hint": "mojang（正版）或 littleskin（皮肤站）",
    "type": "string",
    "default": "mojang"
  },

  "interop_enabled": {
    "description": "启用群服互联",
    "hint": "关闭后不与模组通信，只做本地绑定管理",
    "type": "bool",
    "default": false
  },
  "mc_servers": {
    "description": "MC 服务器列表",
    "hint": "同主机多实例必须错开端口，详见 README §4.1",
    "obvious_hint": true,
    "type": "template_list",
    "default": [],
    "templates": {
      "server": {
        "name": "MC 服务器",
        "items": {
          "name": {
            "description": "服务器名称",
            "hint": "唯一，对应 /info /status /mc 的编号",
            "type": "string",
            "default": "生存服"
          },
          "ws_url": {
            "description": "WebSocket 地址",
            "hint": "形如 ws://127.0.0.1:7789/ws",
            "type": "string",
            "default": "ws://127.0.0.1:7789/ws"
          },
          "http_url": {
            "description": "HTTP 地址",
            "hint": "形如 http://127.0.0.1:7790",
            "type": "string",
            "default": "http://127.0.0.1:7790"
          },
          "token": {
            "description": "该服 Token",
            "hint": "留空则用默认 API Token",
            "type": "string",
            "default": ""
          },
          "enabled": {
            "description": "启用该服务器",
            "hint": "禁用的服务器不参与编号",
            "type": "bool",
            "default": true
          },
          "sync_whitelist": {
            "description": "同步白名单",
            "hint": "是否向该服推送白名单",
            "type": "bool",
            "default": true
          },
          "chat_sync": {
            "description": "转发群消息",
            "hint": "是否向该服转发 QQ 群消息",
            "type": "bool",
            "default": true
          },
          "event_broadcast": {
            "description": "接收事件播报",
            "hint": "是否接收该服玩家事件",
            "type": "bool",
            "default": true
          }
        }
      }
    }
  },
  "default_api_token": {
    "description": "默认 API Token",
    "hint": "需与模组 http.token 一致；两边留空表示不校验",
    "type": "string",
    "default": ""
  },
  "auto_reconnect": {
    "description": "断线自动重连",
    "hint": "1→60 秒指数退避",
    "type": "bool",
    "default": true
  },
  "sync_version_enabled": {
    "description": "白名单带版本号",
    "hint": "推送时携带自增版本号，便于模组判断新旧",
    "type": "bool",
    "default": true
  },
  "heartbeat_seconds": {
    "description": "心跳周期（秒）",
    "hint": "与模组配置保持一致",
    "type": "int",
    "default": 30
  },
  "heartbeat_timeout_seconds": {
    "description": "心跳超时（秒）",
    "hint": "超时判该服离线并标待同步，默认 3×心跳",
    "type": "int",
    "default": 90
  },
  "http_timeout_seconds": {
    "description": "HTTP 超时（秒）",
    "hint": "单次 HTTP 请求的超时时间",
    "type": "int",
    "default": 10
  },
  "dedup_cache_size": {
    "description": "消息去重缓存条数",
    "hint": "按 msg_id 去重，防重复转发",
    "type": "int",
    "default": 512
  },

  "security_mode": {
    "description": "消息安全模式",
    "hint": "none 明文 / prefix 前缀 / encrypted 加密（推荐）",
    "type": "string",
    "default": "encrypted"
  },
  "aes_key": {
    "description": "AES 密钥",
    "hint": "取 UTF-8 前 16 字节，必须与模组 aes_key 完全一致",
    "obvious_hint": true,
    "type": "string",
    "default": ""
  },
  "message_prefix": {
    "description": "消息前缀",
    "hint": "非 none 模式下缺失即拒收",
    "type": "string",
    "default": "[MC]"
  },

  "enable_image_forward": {
    "description": "转发图片链接",
    "hint": "QQ→MC 转发图片时附加图片 URL",
    "type": "bool",
    "default": true
  },
  "enable_at_conversion": {
    "description": "@ 提及转换",
    "hint": "QQ→MC 转发 @ 时转成 @昵称",
    "type": "bool",
    "default": true
  },
  "max_message_length": {
    "description": "转发最大长度",
    "hint": "转发到 MC 的消息超出即截断",
    "type": "int",
    "default": 256
  },
  "chat_forward_trigger": {
    "description": "QQ→MC 触发前缀",
    "hint": "留空 = 群里所有消息都转发（会刷屏），建议填 #",
    "obvious_hint": true,
    "type": "string",
    "default": ""
  },
  "chat_sync_enabled": {
    "description": "启用 QQ→MC 广播",
    "hint": "关闭后群里消息不再转发到服务器",
    "type": "bool",
    "default": true
  },
  "event_server_prefix": {
    "description": "播报带服务器名",
    "hint": "消息与事件播报前加 [服务器名]",
    "type": "bool",
    "default": true
  },
  "group_session_template": {
    "description": "主动推送会话模板",
    "hint": "缓存里没有真实会话时使用，一般不用改",
    "type": "string",
    "default": "{platform}:GroupMessage:{group_id}"
  },
  "platform_id": {
    "description": "平台适配器 ID",
    "hint": "aiocqhttp / qq_official，用于拼推送会话",
    "type": "string",
    "default": "aiocqhttp"
  },

  "group_mode": {
    "description": "群访问控制模式",
    "hint": "whitelist 只服务名单内群 / blacklist 名单内群不服务",
    "type": "string",
    "default": "whitelist"
  },
  "group_list": {
    "description": "群号列表",
    "hint": "留空 = 所有群都服务",
    "type": "list",
    "default": []
  },
  "auto_unbind_on_leave": {
    "description": "退群自动解绑",
    "hint": "依赖平台支持群成员减少通知",
    "type": "bool",
    "default": false
  },
  "auto_cleanup_enabled": {
    "description": "定时检查统计",
    "hint": "每小时记一次绑定/待同步，只清会话缓存",
    "type": "bool",
    "default": false
  },
  "initial_blacklist": {
    "description": "初始 QQ 黑名单",
    "hint": "首次加载时并入，之后用 /black 管理",
    "type": "list",
    "default": []
  },

  "background_images": {
    "description": "统计图背景图",
    "hint": "点按钮上传/删除，可多张轮询；留空则用下面的目录",
    "type": "file",
    "file_types": [
      "png",
      "jpg",
      "jpeg",
      "webp"
    ],
    "default": []
  },
  "background_images_dir": {
    "description": "备用背景图目录",
    "hint": "仅在上传列表为空时使用；相对路径按插件目录解析",
    "type": "string",
    "default": "data/backgrounds"
  },

  "mojang_api": {
    "description": "Mojang API 地址",
    "hint": "正版 UUID 查询接口",
    "type": "string",
    "default": "https://api.mojang.com"
  },
  "littleskin_api": {
    "description": "LittleSkin API",
    "hint": "皮肤站 UUID 查询接口",
    "type": "string",
    "default": "https://littleskin.cn"
  },

  "permission_enabled": {
    "description": "启用权限判定",
    "hint": "关闭后所有成员都能用全部指令",
    "type": "bool",
    "default": true
  },
  "admin_qqs": {
    "description": "管理员 QQ 列表",
    "hint": "群主自动拥有全部权限，不用填写",
    "type": "list",
    "default": []
  },
  "permission_defaults": {
    "description": "普通成员默认权限",
    "hint": "每项对应一个权限节点，管理类建议关闭",
    "type": "object",
    "items": {
      "mcwhitelist.register": {
        "description": "注册 / 注销 / 迁移",
        "hint": "含 /mc 定向发送",
        "type": "bool",
        "default": true
      },
      "mcwhitelist.stats.view": {
        "description": "查看统计",
        "hint": "对应 /info 统计图片",
        "type": "bool",
        "default": true
      },
      "mcwhitelist.blacklist.manage": {
        "description": "管理黑名单",
        "hint": "建议关闭（仅管理员）",
        "type": "bool",
        "default": false
      },
      "mcwhitelist.sync.trigger": {
        "description": "手动同步白名单",
        "hint": "建议关闭（仅管理员）",
        "type": "bool",
        "default": false
      },
      "mcwhitelist.interop.manage": {
        "description": "查看互联状态",
        "hint": "建议关闭（仅管理员）",
        "type": "bool",
        "default": false
      },
      "mcwhitelist.admin.override": {
        "description": "超级管理员节点",
        "hint": "群主自带；普通成员建议关闭",
        "type": "bool",
        "default": false
      }
    }
  }
}
